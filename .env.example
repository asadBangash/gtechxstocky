APP_NAME="G-TechX"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
LOG_CHANNEL=stack

APP_TIMEZONE="UTC"

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_user
DB_PASSWORD=your_password

DUMP_PATH=mysqldump

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
QUEUE_RETRY_AFTER=1200

# Local demo login shop buttons (keep false on production)
DEMO_SHOP_SELECTOR=false
DEMO_SHOP_SELECTOR_FORCE=false

# Product branding (fallbacks when settings row is empty)
BRAND_APP_NAME=G-TechX
BRAND_APP_NAME_DISPLAY=G-TechX
BRAND_COMPANY_NAME=G-TechX
BRAND_DEVELOPED_BY=G-TechX
BRAND_PWA_DESCRIPTION="G-TechX business management"
BRAND_LOGO=logo.png
BRAND_FAVICON=favicon.ico
VENDOR_UPDATES_ENABLED=false

# Copy remaining keys from your local .env as needed (Stripe, SMS, AWS, WooCommerce, etc.)
