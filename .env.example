APP_NAME="Stocky"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
LOG_CHANNEL=stack

APP_TIMEZONE="UTC"

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_user
DB_PASSWORD=your_password

DUMP_PATH=mysqldump

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
QUEUE_RETRY_AFTER=1200

# Local demo login shop buttons (keep false on production)
DEMO_SHOP_SELECTOR=false
DEMO_SHOP_SELECTOR_FORCE=false

# Copy remaining keys from your local .env as needed (Stripe, SMS, AWS, WooCommerce, etc.)
