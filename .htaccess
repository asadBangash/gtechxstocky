# Use this file ONLY when hPanel document root is the Laravel project root
# (the folder that contains artisan), NOT .../public.
# Best practice on Hostinger: set document root to .../gtechx/public and you
# do not need rewrite rules here.

<IfModule mod_rewrite.c>
    Options +FollowSymLinks -Indexes
    RewriteEngine On

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Already under /public — do not rewrite again
    RewriteCond %{REQUEST_URI} ^/public/ [OR]
    RewriteCond %{REQUEST_URI} ^/public$
    RewriteRule ^ - [L]

    # Static file inside public/ (css, js, deploy-check.php, etc.)
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.+)$ public/$1 [L]

    # Everything else → Laravel front controller
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>

<IfModule mod_authz_core.c>
    <Files .env>
        Require all denied
    </Files>
</IfModule>
<IfModule !mod_authz_core.c>
    <Files .env>
        Order allow,deny
        Deny from all
    </Files>
</IfModule>
